{
  "manifest_version": 3,
  "name": "OJ 助手 · 算法生成器",
  "version": "1.11.4",
  "description": "程天学/力扣/洛谷/Codeforces/蓝桥/PTA/牛客/AcWing/AtCoder/VJudge 自动抓题+AI 生成",
  "permissions": ["storage", "alarms", "activeTab", "scripting"],
  "host_permissions": [
    "https://acm.tju.edu.cn/*",
    "http://acm.tju.edu.cn/*",
    "https://leetcode.cn/*",
    "https://leetcode.com/*",
    "https://www.luogu.com.cn/*",
    "https://www.luogu.com/*",
    "https://www.codeforces.com/*",
    "https://codeforces.com/*",
    "https://codeforces.ml/*",
    "https://www.lanqiao.cn/*",
    "https://pintia.cn/*",
    "https://pta.cn/*",
    "https://ac.nowcoder.com/*",
    "https://www.nowcoder.com/*",
    "https://www.acwing.com/*",
    "https://atcoder.jp/*",
    "https://vjudge.net/*",
    "https://api.deepseek.com/*",
    "https://api.siliconflow.cn/*",
    "https://api.moonshot.cn/*",
    "https://dashscope.aliyuncs.com/*",
    "https://ark.cn-beijing.volces.com/*",
    "https://api.zhipuai.cn/*",
    "https://open.bigmodel.cn/*",
    "https://hunyuan.tencentcloudapi.com/*",
    "https://openrouter.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://raw.githubusercontent.com/*",
    "https://cdn.jsdelivr.net/*",
    "https://fastly.jsdelivr.net/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OJ 助手"
  },
  "commands": {
    "ojh_generate": {
      "suggested_key": { "default": "Alt+G" },
      "description": "抓题生成"
    },
    "ojh_copy": {
      "suggested_key": { "default": "Alt+C" },
      "description": "静默生成并复制代码"
    },
    "ojh_toggle": {
      "suggested_key": { "default": "Alt+S" },
      "description": "显示/隐藏悬浮球"
    },
    "ojh_reset": {
      "suggested_key": { "default": "Ctrl+Alt+R" },
      "description": "复位悬浮球位置"
    }
  }
}